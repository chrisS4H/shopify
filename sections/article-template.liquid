<article class="page-width">
  <header class="section-header text-center">
    <h1 class="section-header__title">{{ article.title }}</h1>
    <p class="article__date">{{ article.published_at | time_tag: format: 'month_day_year' }}</p>
  </header>

  <div class="rte" style="max-width: 800px; margin: 0 auto;">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
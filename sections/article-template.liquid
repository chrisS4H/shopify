<article class="page-width" style="margin-top: {{ section.settings.push_down }}px; padding-bottom: 50px;">
  
  <div style="max-width: 800px; margin: 0 auto;">
    <header class="section-header" style="margin-bottom: 40px;">
      <h1 class="section-header__title" style="margin-bottom: 10px;">{{ article.title }}</h1>
      
      {% if section.settings.show_date %}
        <p class="article__date">{{ article.published_at | time_tag: format: 'month_day_year' }}</p>
      {% endif %}
      
      {% if section.settings.show_author %}
        <p class="article__author">By {{ article.author }}</p>
      {% endif %}
    </header>

    <div class="rte">
      {{ article.content }}
    </div>
  </div>

</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "range",
      "id": "push_down",
      "label": "Space below header",
      "min": 50,
      "max": 350,
      "step": 10,
      "default": 180,
      "unit": "px"
    }
  ]
}
{% endschema %}